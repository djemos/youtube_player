#: src/youtube_player.py:1415
msgid ""
"An advanced, thread-safe embedded player for YouTube videos and music with "
"standalone download support."
msgstr ""
"Un reproductor incrustado avanzado y seguro para hilos para videos y música "
"de YouTube con soporte de descarga independiente."

#: src/youtube_player.py:1418
msgid "translator-credits"
msgstr "Dimitris Tzemos <dijemos@gmail.com>"

#: src/youtube_player.py:1433 src/youtube_player.py:1469
msgid "Select Download Folder"
msgstr "Seleccionar Carpeta de Descarga"

#: src/youtube_player.py:1456
msgid "Started downloading"
msgstr "Descarga iniciada"

#: src/youtube_player.py:1570
msgid "Download completed inside"
msgstr "Descarga completada en"

#: src/youtube_player.py:1572
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Error en la descarga. Asegúrese de que ffmpeg esté instalado."

#: src/youtube_player.py:1574
msgid "Error during download process."
msgstr "Error durante el proceso de descarga."

#: src/youtube_player.py:1725
msgid "Export Playlists As"
msgstr "Exportar Playlists Como"

#: src/youtube_player.py:1737 src/youtube_player.py:1852
msgid "JSON Files (*.json)"
msgstr "Archivos JSON (*.json)"

#: src/youtube_player.py:1759
msgid "Export Successful"
msgstr "Exportación Exitosa"

#: src/youtube_player.py:1760
#, python-brace-format
msgid ""
"Your playlists have been safely exported to:\n"
"{}"
msgstr ""
"Sus playlists se han exportado de forma segura a:\n"
"{}"

#: src/youtube_player.py:1765
msgid "Export Failed"
msgstr "Error en la Exportación"

#: src/youtube_player.py:1766
msgid "Could not write the backup file. Please check folder permissions."
msgstr "No se pudo escribir el archivo de respaldo. Por favor, compruebe los permisos de la carpeta."

#: src/youtube_player.py:1823
msgid "Import Strategy"
msgstr "Estrategia de Importación"

#: src/youtube_player.py:1826
msgid ""
"Would you like to Merge the imported playlists with your existing ones, or "
"completely Replace them?"
msgstr "¿Desea combinar las playlists importadas con las existentes o reemplazarlas por completo?"

#: src/youtube_player.py:1830
msgid "Merge Playlists"
msgstr "Combinar Playlists"

#: src/youtube_player.py:1831
msgid "Replace Existing"
msgstr "Reemplazar Existentes"

#: src/youtube_player.py:1842
msgid "Select Playlists File to Import"
msgstr "Seleccione el Archivo de Playlists para Importar"

#: src/youtube_player.py:1885
msgid "Import Failed"
msgstr "Error en la Importación"

#: src/youtube_player.py:1886
msgid ""
"The file could not be parsed. Make sure it is a valid playlists JSON backup."
msgstr "No se pudo analizar el archivo. Asegúrese de que es un respaldo JSON de playlists válido."

#: src/youtube_player.py:1921
msgid "Import Successful"
msgstr "Importación Exitosa"

#: src/youtube_player.py:1922
msgid "Playlists have been successfully loaded and updated into your layout!"
msgstr "¡Las playlists se han cargado y actualizado con éxito en su interfaz!"

#: src/youtube_player.py:1942
msgid "Enter a new unique name for this playlist:"
msgstr "Introduzca un nuevo nombre único para esta playlist:"

#: src/youtube_player.py:1968
msgid "Rename Void"
msgstr "Renombrada Vacía"

#: src/youtube_player.py:1969
msgid "No active playlist selected to rename."
msgstr "No se ha seleccionado ninguna playlist activa para renombrar."

#: src/youtube_player.py:1974
msgid "Recent"
msgstr "Recientes"

#: src/youtube_player.py:1977
msgid "Action Denied"
msgstr "Acción Denegada"

#: src/youtube_player.py:1978
msgid "Cannot rename the default baseline profile."
msgstr "No se puede renombrar el perfil predeterminado del sistema."

#: src/youtube_player.py:1991
msgid "Name Collision"
msgstr "Conflicto de Nombres"

#: src/youtube_player.py:2024
msgid "Error"
msgstr "Error"

#: src/youtube_player.py:2025
msgid "An unexpected error occurred during the renaming process."
msgstr "Ocurrió un error inesperado durante el proceso de renombrado."
