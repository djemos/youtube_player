#: src/youtube_player.py:52 src/youtube_player.py:1412
msgid "YouTube Music & Video Player"
msgstr "Αναπαραγωγέας Μουσικής & Βίντεο YouTube"

#: src/youtube_player.py:105
msgid "Type song title or artist..."
msgstr "Πληκτρολογήστε τίτλο τραγουδιού ή καλλιτέχνη..."

#: src/youtube_player.py:113
msgid "Clear"
msgstr "Καθαρισμός"

#: src/youtube_player.py:128
msgid "Search"
msgstr "Αναζήτηση"

#: src/youtube_player.py:170
msgid "Search Results"
msgstr "Αποτελέσματα Αναζήτησης"

#: src/youtube_player.py:178
msgid "Add Selected to Playlist"
msgstr "Προσθήκη Επιλεγμένου στην Λίστα"

#: src/youtube_player.py:206
msgid "DOUBLE CLICK OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr "ΔΙΠΛΟ ΚΛΙΚ Η ΠΑΤΗΣΤΕ ESC Η F ΓΙΑ ΕΞΟΔΟ ΑΠΟ ΠΛΗΡΗ ΟΘΟΝΗ"

#: src/youtube_player.py:223 src/youtube_player.py:1063
#: src/youtube_player.py:1237 src/youtube_player.py:1359
#: src/youtube_player.py:1616
msgid "Pause"
msgstr "Παύση"

#: src/youtube_player.py:246
msgid "Full Screen (F)"
msgstr "Πλήρης Οθόνη (F)"

#: src/youtube_player.py:255
msgid "Autoplay Next"
msgstr "Αυτόματη Αναπαραγωγή Επόμενου"

#: src/youtube_player.py:271
msgid "New List"
msgstr "Νέα Λίστα"

#: src/youtube_player.py:308
msgid "Playlist Tracks"
msgstr "Κομμάτια Λίστας"

#: src/youtube_player.py:316
msgid "Remove Selected Track"
msgstr "Αφαίρεση Επιλεγμένου Κομματιού"

#: src/youtube_player.py:328
msgid "Delete Playlist"
msgstr "Διαγραφή Λίστας"

#: src/youtube_player.py:340
msgid "Export Playlists"
msgstr "Εξαγωγή Λιστών"

#: src/youtube_player.py:352
msgid "Import Playlists"
msgstr "Εισαγωγή Λιστών"

#: src/youtube_player.py:364 src/youtube_player.py:1929
msgid "Rename Playlist"
msgstr "Μετονομασία Λίστας"

#: src/youtube_player.py:385
msgid "Play"
msgstr "Αναπαραγωγή"

#: src/youtube_player.py:396
msgid "Stop"
msgstr "Διακοπή"

#: src/youtube_player.py:407
msgid "Download MP3"
msgstr "Λήψη MP3"

#: src/youtube_player.py:418
msgid "Download MP4"
msgstr "Λήψη MP4"

#: src/youtube_player.py:431
msgid "About"
msgstr "Πληροφορίες"

#: src/youtube_player.py:453 src/youtube_player.py:1618
msgid "Ready."
msgstr "Έτοιμο."

#: src/youtube_player.py:622
msgid "Unknown Track"
msgstr "Άγνωστο Κομμάτι"

#: src/youtube_player.py:823
msgid "No active playlist selected to delete."
msgstr "Δεν έχει επιλεγεί ενεργή λίστα αναπαραγωγής προς διαγραφή."

#: src/youtube_player.py:831
msgid "Delete Playlist Confirmation"
msgstr "Επιβεβαίωση Διαγραφής Λίστας"

#: src/youtube_player.py:833
msgid "Are you absolutely sure you want to permanently delete"
msgstr "Είστε απόλυτα σίγουροι ότι θέλετε να διαγράψετε μόνιμα τη λίστα"

#: src/youtube_player.py:847
msgid "Playlist"
msgstr "Η Λίστα"

#: src/youtube_player.py:847
msgid "deleted successfully."
msgstr "διαγράφηκε με επιτυχία."

#: src/youtube_player.py:853
msgid "Create New Playlist"
msgstr "Δημιουργία Νέας Λίστας"

#: src/youtube_player.py:854
msgid "Enter a unique name for your custom playlist:"
msgstr "Εισάγετε ένα μοναδικό όνομα για τη δική σας λίστα αναπαραγωγής:"

#: src/youtube_player.py:878 src/youtube_player.py:1992
msgid "Playlist name already exists!"
msgstr "Το όνομα της λίστας αναπαραγωγής υπάρχει ήδη!"

#: src/youtube_player.py:908
msgid "Create or select a playlist first!"
msgstr "Δημιουργήστε ή επιλέξτε μια λίστα αναπαραγωγής πρώτα!"

#: src/youtube_player.py:912
msgid "Track already exists in this list."
msgstr "Το κομμάτι υπάρχει ήδη σε αυτή τη λίστα."

#: src/youtube_player.py:919
msgid "added to"
msgstr "προστέθηκε σε"

#: src/youtube_player.py:933
msgid "Track removed from list."
msgstr "Το κομμάτι αφαιρέθηκε από τη λίστα."

#: src/youtube_player.py:958
msgid "Cleaning yt-dlp cache storage..."
msgstr "Καθαρισμός αποθηκευτικού χώρου cache του yt-dlp..."

#: src/youtube_player.py:964
msgid "Cache cleared successfully. System ready."
msgstr "Η cache καθαρίστηκε με επιτυχία. Το σύστημα είναι έτοιμο."

#: src/youtube_player.py:966
msgid "Failed to purge cache data."
msgstr "Αποτυχία εκκαθάρισης δεδομένων cache."

#: src/youtube_player.py:1060 src/youtube_player.py:1355
msgid "Resume"
msgstr "Συνέχιση"

#: src/youtube_player.py:1167
msgid "Error during search."
msgstr "Σφάλμα κατά την αναζήτηση."

#: src/youtube_player.py:1182
msgid "Displaying"
msgstr "Εμφάνιση"

#: src/youtube_player.py:1182
msgid "unique results."
msgstr "μοναδικών αποτελεσμάτων."

#: src/youtube_player.py:1230
msgid "Loading video:"
msgstr "Φόρτωση βίντεο:"

#: src/youtube_player.py:1265 src/youtube_player.py:1360
msgid "Playing:"
msgstr "Αναπαραγωγή:"

#: src/youtube_player.py:1271
msgid "Failed to start playback."
msgstr "Αποτυχία έναρξης αναπαραγωγής."

#: src/youtube_player.py:1356
msgid "Playback paused."
msgstr "Η αναπαραγωγή τέθηκε σε παύση."

#: src/youtube_player.py:1415
msgid ""
"An advanced, thread-safe embedded player for YouTube videos and music with "
"standalone download support."
msgstr ""
"Ένας προηγμένος, ασφαλής για νήματα (thread-safe) ενσωματωμένος "
"αναπαραγωγέας για βίντεο και μουσική από το YouTube με αυτόνομη υποστήριξη "
"λήψης."

#: src/youtube_player.py:1418
msgid "translator-credits"
msgstr "Δημήτρης Τζέμος <dijemos@gmail.com>"

#: src/youtube_player.py:1433 src/youtube_player.py:1469
msgid "Select Download Folder"
msgstr "Επιλογή Φακέλου Λήψης"

#: src/youtube_player.py:1456
msgid "Started downloading"
msgstr "Ξεκίνησε η λήψη"

#: src/youtube_player.py:1570
msgid "Download completed inside"
msgstr "Η λήψη ολοκληρώθηκε μέσα στο"

#: src/youtube_player.py:1572
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Η λήψη απέτυχε. Βεβαιωθείτε ότι το ffmpeg είναι εγκατεστημένο."

#: src/youtube_player.py:1574
msgid "Error during download process."
msgstr "Σφάλμα κατά τη διάρκεια της διαδικασίας λήψης."

#: src/youtube_player.py:1725
msgid "Export Playlists As"
msgstr "Εξαγωγή Λιστών Αναπαραγωγής Ως"

#: src/youtube_player.py:1737 src/youtube_player.py:1852
msgid "JSON Files (*.json)"
msgstr "Αρχεία JSON (*.json)"

#: src/youtube_player.py:1759
msgid "Export Successful"
msgstr "Επιτυχής Εξαγωγή"

#: src/youtube_player.py:1760
#, python-brace-format
msgid ""
"Your playlists have been safely exported to:\n"
"{}"
msgstr ""
"Οι λίστες αναπαραγωγής σας εξήχθησαν με ασφάλεια στο:\n"
"{}"

#: src/youtube_player.py:1765
msgid "Export Failed"
msgstr "Αποτυχία Εξαγωγής"

#: src/youtube_player.py:1766
msgid "Could not write the backup file. Please check folder permissions."
msgstr "Αδυναμία εγγραφής του αρχείου αντιγράφου ασφαλείας. Παρακαλώ ελέγξτε τα δικαιώματα του φακέλου."

#: src/youtube_player.py:1823
msgid "Import Strategy"
msgstr "Στρατηγική Εισαγωγής"

#: src/youtube_player.py:1826
msgid ""
"Would you like to Merge the imported playlists with your existing ones, or "
"completely Replace them?"
msgstr "Θέλετε να συγχωνεύσετε τις εισαγόμενες λίστες με τις υπάρχουσες, ή να τις αντικαταστήσετε πλήρως;"

#: src/youtube_player.py:1830
msgid "Merge Playlists"
msgstr "Συγχώνευση Λιστών"

#: src/youtube_player.py:1831
msgid "Replace Existing"
msgstr "Αντικατάσταση Υπαρχουσών"

#: src/youtube_player.py:1842
msgid "Select Playlists File to Import"
msgstr "Επιλέξτε Αρχείο Λιστών για Εισαγωγή"

#: src/youtube_player.py:1885
msgid "Import Failed"
msgstr "Αποτυχία Εισαγωγής"

#: src/youtube_player.py:1886
msgid ""
"The file could not be parsed. Make sure it is a valid playlists JSON backup."
msgstr "Αδυναμία ανάλυσης του αρχείου. Βεβαιωθείτε ότι είναι ένα έγκυρο αρχείο JSON αντιγράφου λιστών."

#: src/youtube_player.py:1921
msgid "Import Successful"
msgstr "Επιτυχής Εισαγωγή"

#: src/youtube_player.py:1922
msgid "Playlists have been successfully loaded and updated into your layout!"
msgstr "Οι λίστες αναπαραγωγής φορτώθηκαν με επιτυχία και ενημερώθηκαν στη διεπαφή σας!"

#: src/youtube_player.py:1942
msgid "Enter a new unique name for this playlist:"
msgstr "Εισάγετε ένα νέο μοναδικό όνομα για αυτή τη λίστα αναπαραγωγής:"

#: src/youtube_player.py:1968
msgid "Rename Void"
msgstr "Κενή Μετονομασία"

#: src/youtube_player.py:1969
msgid "No active playlist selected to rename."
msgstr "Δεν έχει επιλεγεί ενεργή λίστα αναπαραγωγής προς μετονομασία."

#: src/youtube_player.py:1974
msgid "Recent"
msgstr "Πρόσφατα"

#: src/youtube_player.py:1977
msgid "Action Denied"
msgstr "Μη Επιτρεπτή Ενέργεια"

#: src/youtube_player.py:1978
msgid "Cannot rename the default baseline profile."
msgstr "Αδυναμία μετονομασίας του προκαθορισμένου βασικού προφίλ."

#: src/youtube_player.py:1991
msgid "Name Collision"
msgstr "Σύγκρουση Ονομάτων"

#: src/youtube_player.py:2024
msgid "Error"
msgstr "Σφάλμα"

#: src/youtube_player.py:2025
msgid "An unexpected error occurred during the renaming process."
msgstr "Προέκυψε ένα απροσδόκητο σφάλμα κατά τη διαδικασία μετονομασίας."
