#: src/youtube_player.py:48 src/youtube_player.py:963
msgid "YouTube Music & Video Player"
msgstr "Αναπαραγωγέας Μουσικής & Βίντεο YouTube"

#: src/youtube_player.py:98
msgid "Type song title or artist..."
msgstr "Πληκτρολογήστε τίτλο τραγουδιού ή καλλιτέχνη..."

#: src/youtube_player.py:106
msgid "Clear"
msgstr "Καθαρισμός"

#: src/youtube_player.py:121
msgid "Search"
msgstr "Αναζήτηση"

#: src/youtube_player.py:158
msgid "Search Results"
msgstr "Αποτελέσματα Αναζήτησης"

#: src/youtube_player.py:166
msgid "Add Selected to Playlist"
msgstr "Προσθήκη Επιλεγμένου στην Playlist"

#: src/youtube_player.py:194
msgid "DOUBLE CLICK HERE OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr "ΔΙΠΛΟ ΚΛΙΚ ΕΔΩ Η ΠΑΤΗΣΤΕ ESC Η F ΓΙΑ ΕΞΟΔΟ ΑΠΟ ΠΛΗΡΗ ΟΘΟΝΗ"

#: src/youtube_player.py:211 src/youtube_player.py:791 src/youtube_player.py:910 src/youtube_player.py:1045
msgid "Pause"
msgstr "Παύση"

#: src/youtube_player.py:234
msgid "Full Screen (F)"
msgstr "Πλήρης Οθόνη (F)"

#: src/youtube_player.py:243
msgid "Autoplay Next"
msgstr "Αυτόματη Αναπαραγωγή Επόμενου"

#: src/youtube_player.py:259
msgid "New List"
msgstr "Νέα Λίστα"

#: src/youtube_player.py:288
msgid "Playlist Tracks"
msgstr "Κομμάτια Playlist"

#: src/youtube_player.py:296
msgid "Remove Selected Track"
msgstr "Αφαίρεση Επιλεγμένου Κομματιού"

#: src/youtube_player.py:308
msgid "Delete Playlist"
msgstr "Διαγραφή Playlist"

#: src/youtube_player.py:328
msgid "Play"
msgstr "Αναπαραγωγή"

#: src/youtube_player.py:339
msgid "Stop"
msgstr "Διακοπή"

#: src/youtube_player.py:350
msgid "Download MP3"
msgstr "Λήψη MP3"

#: src/youtube_player.py:361
msgid "Download MP4"
msgstr "Λήψη MP4"

#: src/youtube_player.py:374
msgid "About"
msgstr "Πληροφορίες"

#: src/youtube_player.py:396 src/youtube_player.py:1047
msgid "Ready."
msgstr "Έτοιμο."

#: src/youtube_player.py:526
msgid "No active playlist selected to delete."
msgstr "Δεν έχει επιλεγεί ενεργή λίστα αναπαραγωγής προς διαγραφή."

#: src/youtube_player.py:530
msgid "Cannot delete the default baseline profile."
msgstr "Αδυναμία διαγραφής του προκαθορισμένου βασικού προφίλ."

#: src/youtube_player.py:538
msgid "Delete Playlist Confirmation"
msgstr "Επιβεβαίωση Διαγραφής Playlist"

#: src/youtube_player.py:540
msgid "Are you absolutely sure you want to permanently delete"
msgstr "Είστε απόλυτα σίγουροι ότι θέλετε να διαγράψετε μόνιμα τη λίστα"

#: src/youtube_player.py:555
msgid "Playlist"
msgstr "Η Playlist"

#: src/youtube_player.py:555
msgid "deleted successfully."
msgstr "διαγράφηκε με επιτυχία."

#: src/youtube_player.py:560
msgid "Create New Playlist"
msgstr "Δημιουργία Νέας Playlist"

#: src/youtube_player.py:561
msgid "Enter a unique name for your custom playlist:"
msgstr "Εισάγετε ένα μοναδικό όνομα για τη δική σας λίστα αναπαραγωγής:"

#: src/youtube_player.py:583
msgid "Playlist name already exists!"
msgstr "Το όνομα της λίστας αναπαραγωγής υπάρχει ήδη!"

#: src/youtube_player.py:594
msgid "Create or select a playlist first!"
msgstr "Δημιουργήστε ή επιλέξτε μια λίστα αναπαραγωγής πρώτα!"

#: src/youtube_player.py:598
msgid "Track already exists in this list."
msgstr "Το κομμάτι υπάρχει ήδη σε αυτή τη λίστα."

#: src/youtube_player.py:603
msgid "Added to"
msgstr "Προστέθηκε στη λίστα"

#: src/youtube_player.py:616
msgid "Track removed from list."
msgstr "Το κομμάτι αφαιρέθηκε από τη λίστα."

#: src/youtube_player.py:626
msgid "Cleaning yt-dlp cache storage..."
msgstr "Καθαρισμός αποθηκευτικού χώρου cache του yt-dlp..."

#: src/youtube_player.py:632
msgid "Cache cleared successfully. System ready."
msgstr "Η cache καθαρίστηκε με επιτυχία. Το σύστημα είναι έτοιμο."

#: src/youtube_player.py:634
msgid "Failed to purge cache data."
msgstr "Αποτυχία εκκαθάρισης δεδομένων cache."

#: src/youtube_player.py:686
msgid "Searching YouTube (fetching 150 items)..."
msgstr "Αναζήτηση στο YouTube (ανάκτηση 150 στοιχείων)..."

#: src/youtube_player.py:721
msgid "Error during search."
msgstr "Σφάλμα κατά την αναζήτηση."

#: src/youtube_player.py:736
msgid "Displaying"
msgstr "Εμφάνιση"

#: src/youtube_player.py:736
msgid "unique results."
msgstr "μοναδικών αποτελεσμάτων."

#: src/youtube_player.py:784
msgid "Loading video:"
msgstr "Φόρτωση βίντεο:"

#: src/youtube_player.py:816 src/youtube_player.py:911
msgid "Playing:"
msgstr "Αναπαραγωγή:"

#: src/youtube_player.py:820
msgid "Failed to start playback."
msgstr "Αποτυχία έναρξης αναπαραγωγής."

#: src/youtube_player.py:906
msgid "Resume"
msgstr "Συνέχιση"

#: src/youtube_player.py:907
msgid "Playback paused."
msgstr "Η αναπαραγωγή τέθηκε σε παύση."

#: src/youtube_player.py:966
msgid "An advanced, thread-safe embedded player for YouTube videos and music with standalone download support."
msgstr "Ένας προηγμένος, ασφαλής για νήματα (thread-safe) ενσωματωμένος αναπαραγωγέας για βίντεο και μουσική από το YouTube με αυτόνομη υποστήριξη λήψης."

#: src/youtube_player.py:984
msgid "Started downloading"
msgstr "Ξεκίνησε η λήψη"

#: src/youtube_player.py:999
msgid "Download completed inside"
msgstr "Η λήψη ολοκληρώθηκε μέσα στο"

#: src/youtube_player.py:1001
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Η λήψη απέτυχε. Βεβαιωθείτε ότι το ffmpeg είναι εγκατεστημένο."

#: src/youtube_player.py:1003
msgid "Error during download process."
msgstr "Σφάλμα κατά τη διάρκεια της διαδικασίας λήψης."
