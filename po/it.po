msgid "Stop"
msgstr "Interrompi"

#: src/youtube_player.py:350
msgid "Download MP3"
msgstr "Scarica MP3"

#: src/youtube_player.py:361
msgid "Download MP4"
msgstr "Scarica MP4"

#: src/youtube_player.py:374
msgid "About"
msgstr "Informazioni"

#: src/youtube_player.py:396 src/youtube_player.py:1047
msgid "Ready."
msgstr "Pronto."

#: src/youtube_player.py:526
msgid "No active playlist selected to delete."
msgstr "Nessuna playlist attiva selezionata per l'eliminazione."

#: src/youtube_player.py:530
msgid "Cannot delete the default baseline profile."
msgstr "Impossibile eliminare il profilo predefinito del sistema."

#: src/youtube_player.py:538
msgid "Delete Playlist Confirmation"
msgstr "Conferma Eliminazione Playlist"

#: src/youtube_player.py:540
msgid "Are you absolutely sure you want to permanently delete"
msgstr "Sei assolutamente sicuro di voler eliminare definitivamente la lista"

#: src/youtube_player.py:555
msgid "Playlist"
msgstr "La Playlist"

#: src/youtube_player.py:555
msgid "deleted successfully."
msgstr "è stata eliminata con successo."

#: src/youtube_player.py:560
msgid "Create New Playlist"
msgstr "Crea Nuova Playlist"

#: src/youtube_player.py:561
msgid "Enter a unique name for your custom playlist:"
msgstr "Inserisci un nome univoco per la tua playlist personalizzata:"

#: src/youtube_player.py:583
msgid "Playlist name already exists!"
msgstr "Il nome di questa playlist esiste già!"

#: src/youtube_player.py:594
msgid "Create or select a playlist first!"
msgstr "Crea o seleziona prima una playlist!"

#: src/youtube_player.py:598
msgid "Track already exists in this list."
msgstr "Questo brano esiste già in questa lista."

#: src/youtube_player.py:603
msgid "Added to"
msgstr "aggiunto alla lista"

#: src/youtube_player.py:616
msgid "Track removed from list."
msgstr "Brano rimosso dalla lista."

#: src/youtube_player.py:626
msgid "Cleaning yt-dlp cache storage..."
msgstr "Pulizia della memoria cache di yt-dlp..."

#: src/youtube_player.py:632
msgid "Cache cleared successfully. System ready."
msgstr "Cache svuotata con successo. Il sistema è pronto."

#: src/youtube_player.py:634
msgid "Failed to purge cache data."
msgstr "Impossibile svuotare i dati della cache."

#: src/youtube_player.py:686
msgid "Searching YouTube (fetching 150 items)..."
msgstr "Ricerca su YouTube (recupero di 150 elementi)..."

#: src/youtube_player.py:721
msgid "Error during search."
msgstr "Errore durante la ricerca."

#: src/youtube_player.py:736
msgid "Displaying"
msgstr "Visualizzazione di"

#: src/youtube_player.py:736
msgid "unique results."
msgstr "risultati univoci."

#: src/youtube_player.py:784
msgid "Loading video:"
msgstr "Caricamento video:"

#: src/youtube_player.py:816 src/youtube_player.py:911
msgid "Playing:"
msgstr "In riproduzione:"

#: src/youtube_player.py:820
msgid "Failed to start playback."
msgstr "Impossibile avviare la riproduzione."

#: src/youtube_player.py:906
msgid "Resume"
msgstr "Riprendi"

#: src/youtube_player.py:907
msgid "Playback paused."
msgstr "Riproduzione in pausa."

#: src/youtube_player.py:966
msgid ""
"An advanced, thread-safe embedded player for YouTube videos and music with "
"standalone download support."
msgstr "Un riproduttore integrato avanzato e thread-safe per video e musica di YouTube con supporto al download indipendente."

#: src/youtube_player.py:984
msgid "Started downloading"
msgstr "Download avviato"

#: src/youtube_player.py:999
msgid "Download completed inside"
msgstr "Download completato in"

#: src/youtube_player.py:1001
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Download fallito. Assicurati che ffmpeg sia installato."

#: src/youtube_player.py:1003
msgid "Error during download process."
msgstr "Errore durante il processo di download."
