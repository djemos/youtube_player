msgid "YouTube Music & Video Player"
msgstr "Riproduttore Video e Musica di YouTube"

#: src/youtube_player.py:98
msgid "Type song title or artist..."
msgstr "Digita il titolo della canzone o l'artista..."

#: src/youtube_player.py:106
msgid "Clear"
msgstr "Cancella"

#: src/youtube_player.py:121
msgid "Search"
msgstr "Cerca"

#: src/youtube_player.py:158
msgid "Search Results"
msgstr "Risultati della Ricerca"

#: src/youtube_player.py:166
msgid "Add Selected to Playlist"
msgstr "Aggiungi Selezionato alla Playlist"

#: src/youtube_player.py:194
msgid "DOUBLE CLICK HERE OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr "DOPPIO CLIC QUI O PREMI ESC O F PER USCIRE DALLO SCHERMO INTERO"

#: src/youtube_player.py:211 src/youtube_player.py:791
#: src/youtube_player.py:910 src/youtube_player.py:1045
msgid "Pause"
msgstr "Pausa"

#: src/youtube_player.py:234
msgid "Full Screen (F)"
msgstr "Schermo Intero (F)"

#: src/youtube_player.py:243
msgid "Autoplay Next"
msgstr "Riproduzione Automatica"

#: src/youtube_player.py:259
msgid "New List"
msgstr "Nuova Lista"

#: src/youtube_player.py:288
msgid "Playlist Tracks"
msgstr "Brani della Playlist"

#: src/youtube_player.py:296
msgid "Remove Selected Track"
msgstr "Rimuovi Brano Selezionato"

