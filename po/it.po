msgstr "Nessuna playlist attiva selezionata per la ridenominazione."

#: src/youtube_player.py:1974
msgid "Recent"
msgstr "Cronologia"

#: src/youtube_player.py:1977
msgid "Action Denied"
msgstr "Azione Negata"

#: src/youtube_player.py:1978
msgid "Cannot rename the default baseline profile."
msgstr "Impossibile rinominare il profilo di base predefinito."

#: src/youtube_player.py:1991
msgid "Name Collision"
msgstr "Conflitto di Nomes"

#: src/youtube_player.py:2024
msgid "Error"
msgstr "Errore"

#: src/youtube_player.py:2025
msgid "An unexpected error occurred during the renaming process."
msgstr "Si è verificato un errore imprevisto durante il processo di ridenominazione."

