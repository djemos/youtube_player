msgstr "Não é possível redefinir o nome do perfil de base predefinido."

#: src/youtube_player.py:1991
msgid "Name Collision"
msgstr "Conflito de Nomes"

#: src/youtube_player.py:2024
msgid "Error"
msgstr "Erro"

