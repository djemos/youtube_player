#: youtube_player.py:46 youtube_player.py:589
msgid "YouTube Music & Video Player"
msgstr "YouTube Musik & Video Player"

#: youtube_player.py:88
msgid "Type song title or artist..."
msgstr "Songtitel oder Künstler eingeben..."

#: youtube_player.py:96
msgid "Clear"
msgstr "Leeren"

#: youtube_player.py:110
msgid "Search"
msgstr "Suchen"

#: youtube_player.py:137
msgid "Title"
msgstr "Titel"

#: youtube_player.py:141
msgid "Source"
msgstr "Quelle"

#: youtube_player.py:162
msgid "DOUBLE CLICK HERE OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr "DOPPELKLICK HIER ODER ESC/F DRÜCKEN, UM VOLLBILD ZU BEENDEN"

#: youtube_player.py:176 youtube_player.py:445 youtube_player.py:532
#: youtube_player.py:663
msgid "Pause"
msgstr "Pause"

#: youtube_player.py:183
msgid "Volume:"
msgstr "Lautstärke:"

#: youtube_player.py:197
msgid "Full Screen (F)"
msgstr "Vollbild (F)"

#: youtube_player.py:207
msgid "Autoplay Next"
msgstr "Nächstes Video automatisch abspielen"

#: youtube_player.py:218
msgid "Play"
msgstr "Abspielen"

#: youtube_player.py:223
msgid "Stop"
msgstr "Stopp"

#: youtube_player.py:228
msgid "Download MP3"
msgstr "MP3 herunterladen"

#: youtube_player.py:233
msgid "Download MP4"
msgstr "MP4 herunterladen"

#: youtube_player.py:241
msgid "About"
msgstr "Über"

#: youtube_player.py:262 youtube_player.py:665
msgid "Ready."
msgstr "Bereit."

#: youtube_player.py:279
msgid "Cleaning yt-dlp cache storage..."
msgstr "yt-dlp Cache-Speicher wird bereinigt..."

#: youtube_player.py:286
msgid "Cache cleared successfully. System ready."
msgstr "Cache erfolgreich geleert. System bereit."

#: youtube_player.py:288
msgid "Failed to purge cache data."
msgstr "Bereinigung der Cache-Daten fehlgeschlagen."

#: youtube_player.py:344
msgid "Searching YouTube (fetching 150 items)..."
msgstr "YouTube wird durchsucht (150 Einträge werden geladen)..."

#: youtube_player.py:381
msgid "Error during search."
msgstr "Fehler bei der Suche."

#: youtube_player.py:400
msgid "Displaying"
msgstr "Es werden"

#: youtube_player.py:400
msgid "unique results."
msgstr "eindeutige Ergebnisse angezeigt."

#: youtube_player.py:441
msgid "Loading video:"
msgstr "Video wird geladen:"

#: youtube_player.py:471 youtube_player.py:533 youtube_player.py:558
msgid "Playing:"
msgstr "Wiedergabe:"

#: youtube_player.py:478
msgid "Failed to start playback."
msgstr "Wiedergabe konnte nicht gestartet werden."

#: youtube_player.py:529
msgid "Resume"
msgstr "Fortsetzen"

#: youtube_player.py:530
msgid "Playback paused."
msgstr "Wiedergabe pausiert."

#: youtube_player.py:547
msgid "Fullscreen Active. Press F, ESC or Double Click to restore."
msgstr "Vollbild aktiv. F, ESC oder Doppelklick drücken, um es zu beenden."

#: youtube_player.py:592
msgid ""
"An advanced, thread-safe embedded player for YouTube videos and music with "
"standalone download support."
msgstr ""
"Ein fortschrittlicher, thread-sicherer eingebetteter Player für YouTube-Videos "
"und Musik mit eigenständiger Download-Unterstützung."

#: youtube_player.py:595
msgid "translator-credits"
msgstr "Dimitris Tzemos <dijemos@gmail.com>"

#: youtube_player.py:611
msgid "Started downloading"
msgstr "Download gestartet"

#: youtube_player.py:626
msgid "Download completed inside"
msgstr "Download erfolgreich abgeschlossen in"

#: youtube_player.py:628
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Download fehlgeschlagen. Stellen Sie sicher, dass ffmpeg installiert ist."

#: youtube_player.py:630
msgid "Error during download process."
msgstr "Fehler während des Download-Vorgangs."
