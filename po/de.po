#: src/youtube_player.py:48 src/youtube_player.py:963
msgid "YouTube Music & Video Player"
msgstr "YouTube Musik- & Videoplayer"

#: src/youtube_player.py:98
msgid "Type song title or artist..."
msgstr "Songtitel oder Künstler eingeben..."

#: src/youtube_player.py:106
msgid "Clear"
msgstr "Leeren"

#: src/youtube_player.py:121
msgid "Search"
msgstr "Suchen"

#: src/youtube_player.py:158
msgid "Search Results"
msgstr "Suchergebnisse"

#: src/youtube_player.py:166
msgid "Add Selected to Playlist"
msgstr "Auswahl zur Playlist hinzufügen"

#: src/youtube_player.py:194
msgid "DOUBLE CLICK HERE OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr "DOPPELKLICK HIER ODER ESC/F DRÜCKEN, UM VOLLBILD ZU BEENDEN"

#: src/youtube_player.py:211 src/youtube_player.py:791
#: src/youtube_player.py:910 src/youtube_player.py:1045
msgid "Pause"
msgstr "Pause"

#: src/youtube_player.py:234
msgid "Full Screen (F)"
msgstr "Vollbild (F)"

#: src/youtube_player.py:243
msgid "Autoplay Next"
msgstr "Nächstes automatisch abspielen"

#: src/youtube_player.py:259
msgid "New List"
msgstr "Neue Liste"

#: src/youtube_player.py:288
msgid "Playlist Tracks"
msgstr "Playlist-Titel"

#: src/youtube_player.py:296
msgid "Remove Selected Track"
msgstr "Ausgewählten Titel entfernen"

#: src/youtube_player.py:308
msgid "Delete Playlist"
msgstr "Playlist löschen"

#: src/youtube_player.py:328
msgid "Play"
msgstr "Wiedergabe"

