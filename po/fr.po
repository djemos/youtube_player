#: youtube_player.py:48 youtube_player.py:1012
msgid "YouTube Music & Video Player"
msgstr "Lecteur de Musique & Vidéo YouTube"

#: youtube_player.py:99
msgid "Type song title or artist..."
msgstr "Entrez le titre de la chanson ou l'artiste..."

#: youtube_player.py:107
msgid "Clear"
msgstr "Effacer"

#: youtube_player.py:122
msgid "Search"
msgstr "Rechercher"

#: youtube_player.py:159
msgid "Search Results"
msgstr "Résultats de la Recherche"

#: youtube_player.py:167
msgid "Add Selected to Playlist"
msgstr "Ajouter la Sélection à la Playlist"

#: youtube_player.py:195
msgid "DOUBLE CLICK HERE OR PRESS ESC OR F TO EXIT FULL SCREEN"
msgstr ""
"DOUBLE-CLIQUER ICI OU APPUYER SUR ESC OU F POUR QUITTER LE MODE PLEIN ÉCRAN"

#: youtube_player.py:212 youtube_player.py:840 youtube_player.py:959
#: youtube_player.py:1095
msgid "Pause"
msgstr "Pause"

#: youtube_player.py:235
msgid "Full Screen (F)"
msgstr "Plein Écran (F)"

#: youtube_player.py:244
msgid "Autoplay Next"
msgstr "Lecture Automatique"

#: youtube_player.py:260
msgid "New List"
msgstr "Nouvelle Liste"

#: youtube_player.py:289
msgid "Playlist Tracks"
msgstr "Pistes de la Playlist"

#: youtube_player.py:297
msgid "Remove Selected Track"
msgstr "Supprimer la Piste Sélectionnée"

#: youtube_player.py:309
msgid "Delete Playlist"
msgstr "Supprimer la Playlist"

#: youtube_player.py:329
msgid "Play"
msgstr "Lecture"

#: youtube_player.py:340
msgid "Stop"
msgstr "Arrêter"

#: youtube_player.py:351
msgid "Download MP3"
msgstr "Télécharger MP3"

#: youtube_player.py:362
msgid "Download MP4"
msgstr "Télécharger MP4"

#: youtube_player.py:375
msgid "About"
msgstr "À propos"

#: youtube_player.py:397 youtube_player.py:1097
msgid "Ready."
msgstr "Prêt."

#: youtube_player.py:528
msgid "No active playlist selected to delete."
msgstr "Aucune playlist active sélectionnée pour la suppression."

#: youtube_player.py:536
msgid "Delete Playlist Confirmation"
msgstr "Confirmation de Suppression de la Playlist"

#: youtube_player.py:538
msgid "Are you absolutely sure you want to permanently delete"
msgstr "Êtes-vous absolument sûr de vouloir supprimer définitivement la liste"

#: youtube_player.py:552
msgid "Playlist"
msgstr "La Playlist"

#: youtube_player.py:552
msgid "deleted successfully."
msgstr "a été supprimée avec succès."

#: youtube_player.py:558 youtube_player.py:589
msgid "Create New Playlist"
msgstr "Créer une Nouvelle Playlist"

#: youtube_player.py:559 youtube_player.py:590
msgid "Enter a unique name for your custom playlist:"
msgstr "Entrez un nom unique pour votre playlist personnalisée :"

#: youtube_player.py:583 youtube_player.py:612
msgid "Playlist name already exists!"
msgstr "Le nom de cette playlist existe déjà !"

#: youtube_player.py:625
msgid "Create or select a playlist first!"
msgstr "Veuillez d'abord créer ou sélectionner une playlist !"

#: youtube_player.py:629
msgid "Track already exists in this list."
msgstr "Cette piste existe déjà dans cette liste."

#: youtube_player.py:636
msgid "added to"
msgstr "ajouté à la"

#: youtube_player.py:650
msgid "Track removed from list."
msgstr "Piste supprimée de la liste."

#: youtube_player.py:675
msgid "Cleaning yt-dlp cache storage..."
msgstr "Nettoyage du stockage cache de yt-dlp..."

#: youtube_player.py:681
msgid "Cache cleared successfully. System ready."
msgstr "Cache vidé avec succès. Système prêt."

#: youtube_player.py:683
msgid "Failed to purge cache data."
msgstr "Échec du nettoyage des données cache."

#: youtube_player.py:735
msgid "Searching YouTube (fetching 150 items)..."
msgstr "Recherche sur YouTube (récupération de 150 éléments)..."

#: youtube_player.py:770
msgid "Error during search."
msgstr "Erreur lors de la recherche."

#: youtube_player.py:785
msgid "Displaying"
msgstr "Affichage de"

#: youtube_player.py:785
msgid "unique results."
msgstr "résultats uniques."

#: youtube_player.py:833
msgid "Loading video:"
msgstr "Chargement de la vidéo :"

#: youtube_player.py:865 youtube_player.py:960
msgid "Playing:"
msgstr "Lecture en cours :"

#: youtube_player.py:869
msgid "Failed to start playback."
msgstr "Échec du démarrage de la lecture."

#: youtube_player.py:955
msgid "Resume"
msgstr "Reprendre"

#: youtube_player.py:956
msgid "Playback paused."
msgstr "Lecture en pause."

#: youtube_player.py:1015
msgid ""
"An advanced, thread-safe embedded player for YouTube videos and music with "
"standalone download support."
msgstr ""
"Un lecteur intégré avancé et sécurisé pour les threads pour les vidéos et la "
"musique YouTube avec prise en charge du téléchargement autonome."

#: youtube_player.py:1018
msgid "translator-credits"
msgstr "Dimitris Tzemos <dijemos@gmail.com>"

#: youtube_player.py:1034
msgid "Started downloading"
msgstr "Téléchargement démarré"

#: youtube_player.py:1049
msgid "Download completed inside"
msgstr "Téléchargement terminé dans"

#: youtube_player.py:1051
msgid "Download failed. Make sure ffmpeg is installed."
msgstr "Téléchargement échoué. Assurez-vous que ffmpeg est installé."

#: youtube_player.py:1053
msgid "Error during download process."
msgstr "Erreur lors du processus de téléchargement."

