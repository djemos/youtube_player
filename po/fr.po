#, python-brace-format
msgid ""
"Your playlists have been safely exported to:\n"
"{}"
msgstr ""
"Vos playlists ont été exportées en toute sécurité dans :\n"
"{}"

#: src/youtube_player.py:1765
msgid "Export Failed"
msgstr "Échec de l'Exportation"

